# BIMFabrikHH API Environment Configuration
# Copy this file to .env and modify as needed
# Copyright (C) 2025 Freie und Hansestadt Hamburg, Landesbetrieb Geoinformation und Vermessung
# BIM-Leitstelle, Ahmed Salem <ahmed.salem@gv.hamburg.de>

# Base Configuration
BASE_URL=http://localhost:8083

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8083

# Main API URLs for the 3 apps
# Tree API (baum app)
TREES_API_URL=https://api.hamburg.de/datasets/v1/strassenbaumkataster/collections/strassenbaumkataster_hh/items

# Tree API Hafen (harbor trees)
TREES_HAFEN_API_URL=https://api.hamburg.de/datasets/v1/strassenbaumkataster_hafen/collections/strbaeume_hpa/items

# DGM API (dgm app)
DGM_TILES_API_URL=https://api.hamburg.de/datasets/v1/uebersicht_kachelbezeichnungen/collections/lgv_kachel_dk5_1km_utm/items

# API Settings
API_TIMEOUT=30
API_DEFAULT_LIMIT=2000
API_DEFAULT_CRS=http://www.opengis.net/def/crs/EPSG/0/25832

# Output URLs for generated files
URL_OUTPUT_HTTP=http://localhost:8083/output
URL_OUTPUT_HTTPS=https://localhost:8083/output

# File system paths
OUTPUT_FOLDER_PATH=output

# Hamburg Open Data - CityGML and DGM source
DATA_BASE_URL=https://daten-hamburg.de/BIM/daten_bimfabrikhh
DATA_LOD1_FOLDER=LoD1-DE_HH_2023
DATA_LOD2_FOLDER=LoD2-DE_HH_2025
DATA_LOD3_FOLDER=Stadtmodell_LoD3
DATA_DGM_FOLDER=dgm_HH_2022

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Admission control (application-level, backed by Redis)
# Per-client rate limiting is opt-in and independent of the concurrency limit.
# Set to True to enforce the request rate limit (only effective with redis backend).
ENABLE_RATE_LIMIT=False
# Rate limit: max RATE_LIMIT_TIMES execution requests per RATE_LIMIT_SECONDS per client identifier
RATE_LIMIT_TIMES=5
RATE_LIMIT_SECONDS=60
# Concurrency limit: max active Celery jobs per client identifier
MAX_CONCURRENT_JOBS=2

# Request analytics (bounding-box KPIs) -> dedicated monitoring PostGIS DB.
# Opt-in and fully identity-decoupled: only the requested extent is stored,
# never the client IP or job id. The DB is the `analytics-postgres` service in
# docker-compose.monitoring.yml (reachable over the shared traefik_default net).
ENABLE_ANALYTICS=False
ANALYTICS_DB_HOST=analytics-postgres
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics
# Change this in real deployments; it is interpolated into compose + the Grafana
# datasource provisioning via ${ANALYTICS_DB_PASSWORD}.
ANALYTICS_DB_PASSWORD=analytics
# Retention window (days); matches the Prometheus/Loki 15-day window.
ANALYTICS_RETENTION_DAYS=15
# SRID of incoming bbox coordinates (4326 = WGS84 lon/lat degrees).
ANALYTICS_BBOX_SRID=4326
ANALYTICS_AREA_SRID=25832

# Celery worker configuration
# Pool type for the worker. Use "prefork" for real parallelism on CPU-bound
# IFC generation (child processes); "solo" runs a single task (debugging only).
# On Windows, python main.py defaults to solo/1 if these are unset (prefork
# hits WinError 6 / invalid handle in billiard).
CELERY_WORKER_POOL=prefork
# Number of child processes = max number of parallel processing jobs per worker.
# Keep conservative due to high in-RAM memory use during model generation.
CELERY_WORKER_CONCURRENCY=2

# Logging configuration
# Per-handler log levels (DEBUG, INFO, WARNING, ERROR, CRITICAL). The console
# handler mirrors what you see in `docker logs`; the file handler writes to a
# shared, rotating log file. The two levels can differ.
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=INFO
# Enable/disable the rotating file handler (console logging always stays on).
LOG_FILE_ENABLED=True
# Path to the shared log file (relative paths resolve against the project root).
LOG_FILE_PATH=logs/bimfabrikhh.log
# Time-based rotation interval (midnight, H, D, S, ...) and number of rotated
# backups to keep.
LOG_FILE_WHEN=midnight
LOG_FILE_BACKUP_COUNT=14